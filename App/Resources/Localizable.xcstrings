    "Usage limit reached. The task waits on the server and continues at %@ by itself — you can close the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzungslimit erreicht. Die Aufgabe wartet auf dem Server und macht um %@ von selbst weiter – du kannst die App schließen."
