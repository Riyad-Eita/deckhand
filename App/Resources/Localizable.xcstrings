          }
        }
      }
    },
    "Root is the one account every attacker knows exists. Logging in as a normal user and using sudo leaves a trail and stops password guessing on root.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Root ist das eine Konto, von dem jeder Angreifer weiß. Wer sich als normaler Nutzer anmeldet und sudo nutzt, hinterlässt Spuren und verhindert Passwort-Raten bei root."
          }
        }
      }
    },
