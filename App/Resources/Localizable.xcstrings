    "Automatic security updates": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Sicherheitsupdates"
          }
        }
      }
    },
    "Back up the files": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien sichern"
          }
        }
      }
    },
    "Backed up on the server before anything changes. If the check fails, they're put back at once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden auf dem Server gesichert, bevor sich etwas ändert. Schlägt die Prüfung fehl, kommen sie sofort zurück."
          }
        }
      }
    },
    "Background tasks": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundaufgaben"
          }
        }
