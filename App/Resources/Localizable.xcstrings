    "Deploy an app from a Git repository: Deckhand fetches it, builds it, starts it, checks it answers, and keeps the last releases so you can roll back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deploye eine App aus einem Git-Repository: Deckhand holt sie, baut sie, startet sie, prüft ob sie antwortet und behält die letzten Releases für ein Rollback."
          }
        }
      }
    },
