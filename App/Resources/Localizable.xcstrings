    "Host, user and password are enough — Deckhand swaps the password for a secure key it creates on this iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Host, Benutzer und Passwort reichen – Deckhand ersetzt das Passwort durch einen sicheren Schlüssel, den es auf diesem iPhone erzeugt."
          }
        }
      }
    },
    "I uploaded a file to %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe eine Datei nach %@ hochgeladen."
          }
        }
      }
    },
    "If a task hits your plan's usage limit, it waits on the server until the limit resets and then continues by itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreicht eine Aufgabe das Nutzungslimit deines Abos, wartet sie auf dem Server, bis das Limit zurückgesetzt ist, und macht dann von selbst weiter."
          }
        }
      }
    },
