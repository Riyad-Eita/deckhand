    "%@ Run it anyway?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Trotzdem ausführen?"
          }
        }
      }
    },
    "%@ already uses port 80 or 443. Stop it or put this domain into its config instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nutzt bereits Port 80 oder 443. Stoppe ihn oder trage diese Domain stattdessen in seine Konfiguration ein."
          }
        }
      }
    },
    "%@ didn't quit in time and was forced to.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat sich nicht rechtzeitig beendet und wurde beendet."
          }
        }
      }
    },
    "%@ doesn't resolve yet. Add an A record for %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ löst noch nicht auf. Lege einen A-Eintrag für %2$@ an."
          }
        }
      }
    },
    "%@ done.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erledigt."
