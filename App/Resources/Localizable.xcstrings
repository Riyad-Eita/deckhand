    "Git doesn't know who you are on this server yet. Set your name and email in the repository settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git weiß auf diesem Server noch nicht, wer du bist. Setz Name und E-Mail für das Repository."
