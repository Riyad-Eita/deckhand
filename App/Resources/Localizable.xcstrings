    "Errors": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler"
          }
        }
      }
    },
    "Every account that can log in is a door. Accounts without a password are an open door.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Konto, das sich anmelden kann, ist eine Tür. Konten ohne Passwort sind eine offene Tür."
          }
        }
      }
    },
    "Every change is backed up first and shows up in the change history, where you can roll it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Änderung wird vorher gesichert und erscheint im Änderungsverlauf, wo du sie zurücksetzen kannst."
          }
        }
      }
    },
    "Every change with a backup, diff and rollback": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Änderung mit Backup, Vergleich und Rückgängig"
          }
        }
      }
    },
    "Explain": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erklären"
          }
        }
      }
    },
    "Failed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlgeschlagen"
          }
        }
      }
    },
    "Fewer password tries per connection slow down guessing; X11 forwarding is rarely needed on a server and widens the attack surface.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger Versuche pro Verbindung bremsen das Raten; X11-Weiterleitung braucht ein Server selten, sie vergrößert nur die Angriffsfläche."
          }
        }
      }
    },
