            "value": "Installiert"
          }
        }
      }
    },
    "Installed packages stay; only the download cache goes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installierte Pakete bleiben; nur der Download-Cache wird gelöscht."
          }
