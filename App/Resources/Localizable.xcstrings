    "Fewer password tries per connection slow down guessing; X11 forwarding is rarely needed on a server and widens the attack surface.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger Versuche pro Verbindung bremsen das Raten; X11-Weiterleitung braucht ein Server selten, sie vergrößert nur die Angriffsfläche."
          }
        }
      }
    },
