    "Open in Terminal": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Terminal öffnen"
          }
        }
      }
    },
    "Open port %@ next to %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Port %1$@ neben %2$@ öffnen"
          }
