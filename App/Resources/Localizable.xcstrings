      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Privaten Schlüssel importieren …"
          }
        }
      }
    },
    "Incoming connections are blocked except SSH (port %@) and web (80, 443). Deckhand logs in again before keeping it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingehende Verbindungen werden geblockt, außer SSH (Port %@) und Web (80, 443). Deckhand meldet sich erneut an, bevor es das behält."
          }
        }
      }
    },
