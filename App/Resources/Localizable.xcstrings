            "state": "translated",
            "value": "Aufgabe abgebrochen"
          }
        }
      }
    },
    "Tasks you give Claude Code or Codex keep running here when you close the app or lose the connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben für Claude Code oder Codex laufen hier weiter, wenn du die App schließt oder die Verbindung abbricht."
