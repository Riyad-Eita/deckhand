      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denkt nach …"
          }
        }
      }
    },
    "This can take whatever depends on %@ offline.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann alles lahmlegen, was von %@ abhängt."
          }
        }
