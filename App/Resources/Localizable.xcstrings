    "%@ is %lld %% full": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist zu %2$lld %% voll"
          }
        }
      }
    },
    "%@ is published on all interfaces. Docker bypasses ufw, so this port is reachable from the internet even if your firewall blocks it. Bind it to 127.0.0.1 in the compose file if it should stay private.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist auf allen Schnittstellen veröffentlicht. Docker umgeht ufw, daher ist dieser Port aus dem Internet erreichbar, auch wenn deine Firewall ihn blockiert. Binde ihn in der Compose-Datei an 127.0.0.1, wenn er privat bleiben soll."
          }
        }
      }
    },
    "%@ is ready": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereit"
          }
