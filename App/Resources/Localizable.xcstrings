        }
      }
    },
    "Use the plan you already pay for — the agent then runs on your server. Or bring an API key and the agent runs on this iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze das Abo, das du schon bezahlst – der Agent läuft dann auf deinem Server. Oder bring einen API-Schlüssel mit, dann läuft der Agent auf diesem iPhone."
          }
        }
      }
    },
    "Use your Claude or ChatGPT plan through Claude Code and Codex on your server — or add an API key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze dein Claude- oder ChatGPT-Abo über Claude Code und Codex auf deinem Server – oder füge einen API-Schlüssel hinzu."
          }
        }
      }
    },
