        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal fragen"
          }
        }
      }
    },
    "Ask questions about any public GitHub repository. No account needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen zu jedem öffentlichen GitHub-Repository. Kein Konto nötig."
