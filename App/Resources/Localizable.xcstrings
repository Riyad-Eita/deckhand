            "value": "Docker"
          }
        }
      }
    },
    "Docker isn't installed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ist nicht installiert"
          }
        }
      }
    },
    "Docker opens published ports itself, before the firewall looks at them — so these are reachable from the internet even if the firewall blocks them. Bind them to 127.0.0.1 if only this server (or a reverse proxy) needs them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker öffnet veröffentlichte Ports selbst, bevor die Firewall sie sieht – sie sind also aus dem Internet erreichbar, selbst wenn die Firewall sie blockt. Binde sie an 127.0.0.1, wenn nur dieser Server (oder ein Reverse Proxy) sie braucht."
          }
        }
      }
    },
    "Docker ports past the firewall": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker-Ports an der Firewall vorbei"
          }
        }
      }
    },
