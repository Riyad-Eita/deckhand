    "Find out what runs on this server: sites and domains, how requests reach the apps, databases, containers, cron jobs, backups and certificates. Read-only, nothing changes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde heraus, was auf diesem Server läuft: Websites und Domains, wie Anfragen zu den Apps kommen, Datenbanken, Container, Cron-Jobs, Backups und Zertifikate. Nur lesend, nichts wird geändert."
          }
        }
      }
    },
