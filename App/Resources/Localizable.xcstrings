      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Firewall: alles blocken außer SSH und offenen Web-Ports"
          }
        }
      }
    },
    "First connection to %@. Its host key fingerprint is\n%@\n\nDeckhand remembers it and warns you if it ever changes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste Verbindung zu %1$@. Der Fingerabdruck des Host-Schlüssels ist\n%2$@\n\nDeckhand merkt ihn sich und warnt dich, falls er sich je ändert."
          }
        }
      }
    },
