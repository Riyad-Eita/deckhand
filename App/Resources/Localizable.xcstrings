    },
    "Installing the GitHub CLI…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere die GitHub CLI …"
          }
        }
      }
    },
    "Installs %lld security updates. Services may restart briefly. Your changed config files are kept. This can't be rolled back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert %lld Sicherheitsupdates. Dienste starten eventuell kurz neu. Deine geänderten Konfigurationsdateien bleiben erhalten. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
    "Installs %lld updates. Services may restart briefly. Your changed config files are kept. This can't be rolled back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert %lld Updates. Dienste starten eventuell kurz neu. Deine geänderten Konfigurationsdateien bleiben erhalten. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
    "Installs Caddy if needed and serves %@ from %@ with HTTPS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert Caddy bei Bedarf und liefert %1$@ von %2$@ mit HTTPS aus."
          }
        }
      }
    },
    "Installs all waiting updates with the package manager. Services may restart briefly. This can't be rolled back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert alle wartenden Updates mit dem Paketmanager. Dienste starten eventuell kurz neu. Das lässt sich nicht zurücksetzen."
          }
        }
      }
    },
    "Installs fail2ban if needed and bans addresses that keep failing to log in over SSH (and to your website, if nginx or Apache runs here) for an hour.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert fail2ban bei Bedarf und sperrt Adressen für eine Stunde, die sich immer wieder falsch per SSH anmelden (und bei deiner Website, falls hier nginx oder Apache läuft)."
          }
        }
      }
    },
    "Installs restic if needed (no root), creates an encrypted repository and schedules the nightly run.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert restic bei Bedarf (ohne root), legt ein verschlüsseltes Repository an und plant den nächtlichen Lauf."
          }
        }
      }
    },
    "Instead of just stopping Claude Code or Codex, the server sends a push with Allow and Deny — also while the app is closed. Commands that can't be undone open Deckhand for Face ID. No answer means no.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt Claude Code oder Codex nur zu stoppen, schickt der Server einen Push mit Erlauben und Ablehnen – auch wenn die App geschlossen ist. Befehle, die sich nicht rückgängig machen lassen, öffnen Deckhand für Face ID. Keine Antwort heißt nein."
          }
        }
      }
    },
    "Internal": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intern"
          }
        }
      }
    },
    "Interrupted": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterbrochen"
          }
        }
      }
    },
