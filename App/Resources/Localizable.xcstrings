    "A firewall blocks everything you didn't open on purpose — a database or admin panel that listens by accident stays private.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Firewall blockt alles, was du nicht bewusst geöffnet hast – eine Datenbank oder ein Admin-Panel, das versehentlich lauscht, bleibt privat."
          }
        }
      }
    },
    "A folder on this server": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ordner auf diesem Server"
          }
        }
      }
    },
    "A fresh login didn't work (%@), so the change was rolled back right away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Anmeldung hat nicht funktioniert (%@), deshalb wurde die Änderung sofort zurückgesetzt."
          }
