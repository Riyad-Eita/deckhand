    },
    "A score and a list of fixes, worst first": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Score und eine Liste von Fixes, das Wichtigste zuerst"
          }
        }
      }
    },
    "A system file every user can write is an easy way to become root.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Systemdatei, die jeder Nutzer ändern kann, ist ein einfacher Weg zu root."
