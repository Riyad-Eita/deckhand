        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholte Fehlversuche blockieren"
          }
        }
      }
    },
    "Bots try millions of passwords against every server on the internet. With password logins off, only someone holding your key can get in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bots probieren Millionen Passwörter an jedem Server im Internet. Ohne Passwort-Logins kommt nur rein, wer deinen Schlüssel hat."
          }
        }
      }
    },
